# Copy to prod.env and fill in. prod.env is git-ignored — it holds real secrets.
#
# Under SPRING_PROFILES_ACTIVE=prod every value here has NO default: a missing
# one fails the boot instead of silently falling back to a dev value.

# ----- MySQL: the MYSQL_* pair creates the database, the DB_* pair connects to it.
# Keep DB_NAME/DB_USER/DB_PASSWORD identical to their MYSQL_ counterparts.
#
# Do not rename the database. tableCreationQueries.sql hardcodes
# `USE growth_buddy`, so the schema lands there whatever you set here — and the
# app would then connect to an empty database and 500 on every request. Change
# the schema file first if you really need a different name.
MYSQL_DATABASE=growth_buddy
MYSQL_USER=growthbuddy
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

DB_NAME=growth_buddy
DB_USER=growthbuddy
DB_PASSWORD=
# DB_HOST and DB_SSL_MODE are set by docker-compose.yml. Don't set them here.

# ----- Session signing. 32+ random bytes; rotating it logs everyone out.
#   openssl rand -base64 48
SESSION_HMAC_SECRET=

# ----- Public hostname. Caddy gets its certificate for this name, so it must
# already resolve to this box before the first `docker compose up`.
# A free DuckDNS subdomain works and, crucially, is stable.
PUBLIC_HOSTNAME=growthbuddy.duckdns.org
ACME_EMAIL=you@example.com

# ----- Your public origin, comma-separated. Never localhost.
# Caddy, the API and the frontend share one origin, so this is just the URL
# above — scheme included, no trailing slash. Must match PUBLIC_HOSTNAME.
CORS_ALLOWED_ORIGINS=https://growthbuddy.duckdns.org

# ----- Optional. Each is dark until set; none of them block a deploy.
# MAIL_USER=            # without these, OTP email fails in prod rather than logging
# MAIL_PASS=
# OPENAI_API_KEY=       # AI mentor falls back to a canned reply
# VAPID_PUBLIC_KEY=     # web push is inert without these
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# WHATSAPP_ENABLED=false
