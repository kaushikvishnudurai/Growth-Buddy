# Growth Buddy — environment variables
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# ----- Frontend (Vite) -----
# Base URL the browser app calls. Only VITE_-prefixed vars are exposed to the
# client bundle. Leave empty in dev to use the Vite proxy (relative /api), or
# set an absolute URL (e.g. https://api.growthbuddy.app) for production builds.
VITE_API_BASE=

# ----- MySQL -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=growth_buddy
DB_USER=root
DB_PASSWORD=

# ----- Gmail SMTP (leave empty for console-log fallback) -----
# 1. Enable 2-Step Verification on the Google account.
# 2. Visit https://myaccount.google.com/apppasswords and generate a 16-char
#    "App password" for "Mail". Paste it as MAIL_PASS (no spaces).
MAIL_USER=
MAIL_PASS=

# Optional: From address / display name shown in the recipient's inbox.
# Defaults: MAIL_FROM uses MAIL_USER; MAIL_FROM_NAME is "Growth Buddy".
MAIL_FROM=
MAIL_FROM_NAME="Growth Buddy"

# Optional SMTP overrides — leave as-is for Gmail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ----- AI Mentor (Claude via Cloudflare AI Gateway) -----
# The gateway's OpenAI-compatible endpoint, copied from the Cloudflare dashboard:
#   https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway>/compat
# (the trailing /chat/completions is optional — the client adds it if missing).
# The token is a Cloudflare API token with AI Gateway access.
# With either one empty, every AI feature falls back to its canned offline reply.
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
AI_MODEL=anthropic/claude-sonnet-4-5

# ----- Deployment (production only) -----
# SPRING_PROFILES_ACTIVE=prod activates application-prod.yml, which requires the
# vars below and pins ddl-auto=validate. Four guards in the code key off this
# string; without it the app boots on the dev HMAC secret and logs OTPs to the
# console. The Dockerfile sets it for you — set it yourself if you run the jar.
# SPRING_PROFILES_ACTIVE=prod
# SESSION_HMAC_SECRET=           # openssl rand -base64 48 (32+ chars, required)
# CORS_ALLOWED_ORIGINS=          # your web origin; irrelevant but required if the API serves the bundle
# DB_SSL_MODE=REQUIRED           # DISABLED only for a socket-local MySQL
# SPRING_JPA_DDL_AUTO=validate   # schema is owned by tableCreationQueries.sql

# ----- WhatsApp OTP / reminders (Meta / Facebook WhatsApp Cloud API) -----
# If empty/disabled, OTPs are logged to the backend console instead of sent.
# Set up: https://developers.facebook.com  ->  your App  ->  WhatsApp  ->  API Setup.
# Copy the Phone number ID and a (permanent) access token from there.
# Note: proactive messages outside the 24h window require an approved template.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Approved template name, body = a single {{1}} variable ("Growth Buddy reminder: {{1}}").
# Empty => free-form text, which only lands inside the 24h window, so scheduled
# reminders will fail. Required for real reminder delivery.
WHATSAPP_TEMPLATE=
# AUTHENTICATION-category template for OTPs (body + copy-code button, no free text).
# Meta refuses to create one until the business is verified; empty => OTPs use the
# template above, which works but risks a category-mismatch rejection later.
WHATSAPP_AUTH_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ----- Web Push notifications (VAPID) -----
# Generate a key pair once:  npx web-push generate-vapid-keys --json
# Leave empty to disable push (the app just won't offer to enable it).
# Note: browsers only allow push on HTTPS (or http://localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ----- Production hardening (set these before deploying) -----
# Marks the deploy as production: disables OTP-to-console logging, skips the
# demo-user seed, and makes a missing SESSION_HMAC_SECRET fail fast.
SPRING_PROFILES_ACTIVE=prod

# Private random string used to HMAC session tokens. MUST be set in prod
# (startup aborts on the built-in dev default). Generate: openssl rand -hex 32
SESSION_HMAC_SECRET=

# Comma-separated allowed browser origins for CORS (your frontend URL(s)).
CORS_ALLOWED_ORIGINS=https://app.growthbuddy.example

# Set true ONLY when behind a reverse proxy / load balancer you control that
# sets X-Forwarded-For. If false, per-IP rate limits use the socket peer so the
# header can't be spoofed to bypass them.
TRUST_PROXY=false

# Schema is owned by tableCreationQueries.sql in prod — 'validate' prevents a
# deploy from silently altering/locking a live table. Dev leaves this unset ('update').
SPRING_JPA_DDL_AUTO=validate

# ----- Scaling knobs (safe defaults; tune under load test) -----
DB_POOL_SIZE=40
TOMCAT_MAX_THREADS=300
TOMCAT_MAX_CONNECTIONS=10000

# ----- Server timezone -----
# Day boundaries no longer depend on this: habit check-ins, streaks, scores, wellness
# and water resolve "today" through UserClock, i.e. each user's own users.timezone
# (set from the browser at signup, editable in Settings). This only affects log
# timestamps and anything without a user in scope, so it is safe to leave unset.
TZ=Asia/Kolkata
