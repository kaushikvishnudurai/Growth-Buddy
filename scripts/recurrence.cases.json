{
  "_comment": [
    "The one list of recurrence cases BOTH implementations are tested against.",
    "scripts/recurrence.test.mjs reads it, and so does ReminderServiceOccursOnTest",
    "on the Java side — which exists only because the WhatsApp scheduler cannot",
    "import JavaScript. Add a case here and both sides have to satisfy it, so the",
    "two can no longer drift in silence the way they did before.",
    "",
    "reminder.date is the anchor. workWeek applies only to the 'weekdays' repeat;",
    "omitted means the default, Mon-Fri.",
    "",
    "repeatInterval / repeatDays ('MO,WE,FR', weekly only) / repeatNth (1..5 or -1,",
    "monthly only, weekday taken from the anchor) / repeatCount are optional and",
    "map 1:1 onto CalendarReminder's repeat_* columns. Weeks start on Monday."
  ],
  "cases": [
    { "why": "one-off fires on its own day", "reminder": { "date": "2026-09-14", "repeat": "none" }, "day": "2026-09-14", "expect": true },
    { "why": "one-off, the next day", "reminder": { "date": "2026-09-14", "repeat": "none" }, "day": "2026-09-15", "expect": false },
    { "why": "daily covers the weekend", "reminder": { "date": "2026-09-14", "repeat": "daily" }, "day": "2026-09-19", "expect": true },
    { "why": "weekly = the same weekday", "reminder": { "date": "2026-09-14", "repeat": "weekly" }, "day": "2026-09-21", "expect": true },
    { "why": "weekly, a different weekday", "reminder": { "date": "2026-09-14", "repeat": "weekly" }, "day": "2026-09-22", "expect": false },

    { "why": "Mon-Fri: Monday", "reminder": { "date": "2026-09-14", "repeat": "weekdays" }, "day": "2026-09-14", "expect": true },
    { "why": "Mon-Fri: Friday", "reminder": { "date": "2026-09-14", "repeat": "weekdays" }, "day": "2026-09-18", "expect": true },
    { "why": "Mon-Fri: Saturday is off", "reminder": { "date": "2026-09-14", "repeat": "weekdays" }, "day": "2026-09-19", "expect": false },
    { "why": "Mon-Fri: Sunday is off", "reminder": { "date": "2026-09-14", "repeat": "weekdays" }, "day": "2026-09-20", "expect": false },
    { "why": "anchored on a Saturday, its own day does not fire", "reminder": { "date": "2026-09-12", "repeat": "weekdays" }, "day": "2026-09-12", "expect": false },
    { "why": "anchored on a Saturday, the Monday after does", "reminder": { "date": "2026-09-12", "repeat": "weekdays" }, "day": "2026-09-14", "expect": true },

    { "why": "Sun-Thu: Sunday is a working day", "reminder": { "date": "2026-09-13", "repeat": "weekdays" }, "day": "2026-09-13", "workWeek": "sun_thu", "expect": true },
    { "why": "Sun-Thu: Thursday", "reminder": { "date": "2026-09-13", "repeat": "weekdays" }, "day": "2026-09-17", "workWeek": "sun_thu", "expect": true },
    { "why": "Sun-Thu: Friday is the weekend", "reminder": { "date": "2026-09-13", "repeat": "weekdays" }, "day": "2026-09-18", "workWeek": "sun_thu", "expect": false },
    { "why": "Sun-Thu: Saturday is the weekend", "reminder": { "date": "2026-09-13", "repeat": "weekdays" }, "day": "2026-09-19", "workWeek": "sun_thu", "expect": false },
    { "why": "Mon-Sat: Saturday is a working day", "reminder": { "date": "2026-09-14", "repeat": "weekdays" }, "day": "2026-09-19", "workWeek": "mon_sat", "expect": true },
    { "why": "Mon-Sat: Sunday is still off", "reminder": { "date": "2026-09-14", "repeat": "weekdays" }, "day": "2026-09-20", "workWeek": "mon_sat", "expect": false },
    { "why": "an unknown work week falls back to Mon-Fri", "reminder": { "date": "2026-09-14", "repeat": "weekdays" }, "day": "2026-09-19", "workWeek": "nonsense", "expect": false },

    { "why": "until stops a weekdays series", "reminder": { "date": "2026-09-14", "repeat": "weekdays", "until": "2026-09-16" }, "day": "2026-09-17", "expect": false },
    { "why": "a skipped occurrence does not fire", "reminder": { "date": "2026-09-14", "repeat": "weekdays", "skip": ["2026-09-16"] }, "day": "2026-09-16", "expect": false },
    { "why": "nothing fires before the anchor", "reminder": { "date": "2026-09-14", "repeat": "weekdays" }, "day": "2026-09-11", "expect": false },
    { "why": "from trims the front of a series", "reminder": { "date": "2026-09-14", "repeat": "daily", "from": "2026-09-16" }, "day": "2026-09-15", "expect": false },

    { "why": "monthly anchored on the 31st clamps to Feb 28", "reminder": { "date": "2026-01-31", "repeat": "monthly" }, "day": "2026-02-28", "expect": true },
    { "why": "...and not to Feb 27", "reminder": { "date": "2026-01-31", "repeat": "monthly" }, "day": "2026-02-27", "expect": false },
    { "why": "...and still lands on a real 31st", "reminder": { "date": "2026-01-31", "repeat": "monthly" }, "day": "2026-03-31", "expect": true },
    { "why": "a leap-day yearly falls back to Feb 28 in a common year", "reminder": { "date": "2028-02-29", "repeat": "yearly" }, "day": "2029-02-28", "expect": true },
    { "why": "...and still lands on a real Feb 29", "reminder": { "date": "2028-02-29", "repeat": "yearly" }, "day": "2032-02-29", "expect": true },

    { "why": "every 2 days: day 2", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatInterval": 2 }, "day": "2026-09-16", "expect": true },
    { "why": "every 2 days: day 1 is off", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatInterval": 2 }, "day": "2026-09-15", "expect": false },
    { "why": "every 3 days: day 6", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatInterval": 3 }, "day": "2026-09-20", "expect": true },
    { "why": "an interval of 1 is plain weekly", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatInterval": 1 }, "day": "2026-09-21", "expect": true },
    { "why": "every 2 weeks: the week after is off", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatInterval": 2 }, "day": "2026-09-21", "expect": false },
    { "why": "every 2 weeks: two weeks on", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatInterval": 2 }, "day": "2026-09-28", "expect": true },
    { "why": "weekly on Mon/Wed/Fri: Wednesday", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "MO,WE,FR" }, "day": "2026-09-16", "expect": true },
    { "why": "weekly on Mon/Wed/Fri: Thursday is off", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "MO,WE,FR" }, "day": "2026-09-17", "expect": false },
    { "why": "weekly on Mon/Wed/Fri: Friday", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "MO,WE,FR" }, "day": "2026-09-18", "expect": true },
    { "why": "weekly on Tue/Thu anchored on a Monday: the anchor does not fire", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "TU,TH" }, "day": "2026-09-14", "expect": false },
    { "why": "weekly on Tue/Thu anchored on a Monday: the Tuesday does", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "TU,TH" }, "day": "2026-09-15", "expect": true },
    { "why": "empty days fall back to the anchor's weekday", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "" }, "day": "2026-09-21", "expect": true },
    { "why": "every 2 weeks on Mon/Fri: Friday of week 0", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "MO,FR", "repeatInterval": 2 }, "day": "2026-09-18", "expect": true },
    { "why": "every 2 weeks on Mon/Fri: Friday of week 1 is off", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "MO,FR", "repeatInterval": 2 }, "day": "2026-09-25", "expect": false },
    { "why": "every 2 weeks on Mon/Fri: Friday of week 2", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "MO,FR", "repeatInterval": 2 }, "day": "2026-10-02", "expect": true },
    { "why": "weeks start on Monday: the Sunday after the anchor is still week 0", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "SU", "repeatInterval": 2 }, "day": "2026-09-20", "expect": true },
    { "why": "...and the Sunday after that is week 1", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "SU", "repeatInterval": 2 }, "day": "2026-09-27", "expect": false },
    { "why": "weekdays ignores an interval", "reminder": { "date": "2026-09-14", "repeat": "weekdays", "repeatInterval": 2 }, "day": "2026-09-15", "expect": true },

    { "why": "every 3 months: three on", "reminder": { "date": "2026-01-15", "repeat": "monthly", "repeatInterval": 3 }, "day": "2026-04-15", "expect": true },
    { "why": "every 3 months: the month after is off", "reminder": { "date": "2026-01-15", "repeat": "monthly", "repeatInterval": 3 }, "day": "2026-02-15", "expect": false },
    { "why": "every 2 months from the 31st: March 31", "reminder": { "date": "2026-01-31", "repeat": "monthly", "repeatInterval": 2 }, "day": "2026-03-31", "expect": true },
    { "why": "every 2 months from the 31st: no clamp in an off month", "reminder": { "date": "2026-01-31", "repeat": "monthly", "repeatInterval": 2 }, "day": "2026-02-28", "expect": false },
    { "why": "2nd Tuesday: October's is the 13th", "reminder": { "date": "2026-09-08", "repeat": "monthly", "repeatNth": 2 }, "day": "2026-10-13", "expect": true },
    { "why": "2nd Tuesday: not the 1st Tuesday", "reminder": { "date": "2026-09-08", "repeat": "monthly", "repeatNth": 2 }, "day": "2026-10-06", "expect": false },
    { "why": "2nd Tuesday: not the date of the anchor", "reminder": { "date": "2026-09-08", "repeat": "monthly", "repeatNth": 2 }, "day": "2026-10-08", "expect": false },
    { "why": "last Friday: October 30", "reminder": { "date": "2026-09-25", "repeat": "monthly", "repeatNth": -1 }, "day": "2026-10-30", "expect": true },
    { "why": "last Friday: not October 23", "reminder": { "date": "2026-09-25", "repeat": "monthly", "repeatNth": -1 }, "day": "2026-10-23", "expect": false },
    { "why": "last Friday: November 27", "reminder": { "date": "2026-09-25", "repeat": "monthly", "repeatNth": -1 }, "day": "2026-11-27", "expect": true },
    { "why": "5th Tuesday: October has none, so its 4th is off", "reminder": { "date": "2026-09-29", "repeat": "monthly", "repeatNth": 5 }, "day": "2026-10-27", "expect": false },
    { "why": "5th Tuesday: December 29", "reminder": { "date": "2026-09-29", "repeat": "monthly", "repeatNth": 5 }, "day": "2026-12-29", "expect": true },
    { "why": "2nd Tuesday every 2 months: October is off", "reminder": { "date": "2026-09-08", "repeat": "monthly", "repeatNth": 2, "repeatInterval": 2 }, "day": "2026-10-13", "expect": false },
    { "why": "2nd Tuesday every 2 months: November 10", "reminder": { "date": "2026-09-08", "repeat": "monthly", "repeatNth": 2, "repeatInterval": 2 }, "day": "2026-11-10", "expect": true },
    { "why": "every 2 years: the year after is off", "reminder": { "date": "2026-03-10", "repeat": "yearly", "repeatInterval": 2 }, "day": "2027-03-10", "expect": false },
    { "why": "every 2 years: two on", "reminder": { "date": "2026-03-10", "repeat": "yearly", "repeatInterval": 2 }, "day": "2028-03-10", "expect": true },

    { "why": "3 times daily: the third", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatCount": 3 }, "day": "2026-09-16", "expect": true },
    { "why": "3 times daily: not a fourth", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatCount": 3 }, "day": "2026-09-17", "expect": false },
    { "why": "a skipped day still uses up one of the count", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatCount": 3, "skip": ["2026-09-15"] }, "day": "2026-09-17", "expect": false },
    { "why": "...and the ones left still fire", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatCount": 3, "skip": ["2026-09-15"] }, "day": "2026-09-16", "expect": true },
    { "why": "from trims the front but does not restart the count", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatCount": 5, "from": "2026-09-16" }, "day": "2026-09-18", "expect": true },
    { "why": "...so the sixth day is still past the end", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatCount": 5, "from": "2026-09-16" }, "day": "2026-09-19", "expect": false },
    { "why": "4 times on Mon/Wed/Fri: the 4th is the next Monday", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "MO,WE,FR", "repeatCount": 4 }, "day": "2026-09-21", "expect": true },
    { "why": "4 times on Mon/Wed/Fri: no 5th", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "MO,WE,FR", "repeatCount": 4 }, "day": "2026-09-23", "expect": false },
    { "why": "the count skips an anchor the rule does not land on", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "TU,TH", "repeatCount": 2 }, "day": "2026-09-17", "expect": true },
    { "why": "...so its third Tuesday is past the end", "reminder": { "date": "2026-09-14", "repeat": "weekly", "repeatDays": "TU,TH", "repeatCount": 2 }, "day": "2026-09-22", "expect": false },
    { "why": "twice yearly: the second year", "reminder": { "date": "2026-03-10", "repeat": "yearly", "repeatCount": 2 }, "day": "2027-03-10", "expect": true },
    { "why": "twice yearly: not a third", "reminder": { "date": "2026-03-10", "repeat": "yearly", "repeatCount": 2 }, "day": "2028-03-10", "expect": false },
    { "why": "until wins over a count that would run longer", "reminder": { "date": "2026-09-14", "repeat": "daily", "repeatCount": 10, "until": "2026-09-15" }, "day": "2026-09-16", "expect": false },
    { "why": "a count on a one-off means nothing", "reminder": { "date": "2026-09-14", "repeat": "none", "repeatCount": 1 }, "day": "2026-09-14", "expect": true }
  ]
}
