+<?xml version="1.0" encoding="utf-8"?>
+<!-- The notification small icon: the logomark's sprout, one colour. Android
+     draws only its alpha (iconColor in capacitor.config.json tints it), so a
+     full-colour icon here would render as a white blob. Viewport is the
+     logomark's 64-unit box cropped to the sprout. -->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="44"
+    android:viewportHeight="44">
+    <group android:translateX="-10" android:translateY="-9">
+        <path
+            android:pathData="M32,48V30"
+            android:strokeColor="#FFFFFFFF"
+            android:strokeWidth="5"
+            android:strokeLineCap="round" />
+        <path
+            android:fillColor="#FFFFFFFF"
+            android:pathData="M32,33C24,33 17.5,27 18.5,17.5C28,16.5 34,23 32,33Z" />
+        <path
+            android:fillColor="#FFFFFFFF"
+            android:pathData="M32,30C40,30 46.5,24 45.5,14.5C36,13.5 30,20 32,30Z" />
+    </group>
+</vector>
diff --git a/android/app/src/main/res/xml/data_extraction_rules.xml b/android/app/src/main/res/xml/data_extraction_rules.xml
new file mode 100644
index 0000000..ad61e39
--- /dev/null
+++ b/android/app/src/main/res/xml/data_extraction_rules.xml
@@ -0,0 +1,23 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Android 12+: nothing leaves the phone in a cloud backup or a
+     phone-to-phone transfer. The WebView's cookies (gb.token, gb.session)
+     and Cache API live in app data; restored onto another phone they were a
+     live session the signed-in-devices list never saw. Everything the user
+     owns is on the server, so there is nothing here worth backing up.
+     (allowBackup="false" covers Android 11 and below.) -->
+<data-extraction-rules>
+    <cloud-backup>
+        <exclude domain="root" />
+        <exclude domain="file" />
+        <exclude domain="database" />
+        <exclude domain="sharedpref" />
+        <exclude domain="external" />
+    </cloud-backup>
+    <device-transfer>
+        <exclude domain="root" />
+        <exclude domain="file" />
+        <exclude domain="database" />
+        <exclude domain="sharedpref" />
+        <exclude domain="external" />
+    </device-transfer>
+</data-extraction-rules>
